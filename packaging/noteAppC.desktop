[Desktop Entry]
Type=Application
Name=noteAppC
GenericName=Markdown Notes
Comment=Read and edit Markdown notes and vaults
Exec=noteAppC %f
TryExec=noteAppC
Icon=noteAppC
Terminal=false
Categories=Office;
