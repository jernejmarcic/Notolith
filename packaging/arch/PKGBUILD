# Builds Notolith from the tagged git source, in the usual AUR way:
#
#   makepkg -si
#
# makepkg builds in src/ and pkg/ beside this file. It also runs the test
# suites (check() builds them in a second build directory, with
# QT_QPA_PLATFORM=offscreen); `makepkg -si --nocheck` skips that.
#
# One build, four packages (docs/INK.md): notolith (the application),
# notolith-ink (the handwriting core library and module), notolith-hwfont
# (the glyph studio module) and notolith-pdfview (the PDF viewer module and the
# poppler half of PDF embeds). Install every one of a run together: a module is
# only loaded by the build that made it (the ABI tag).
#
# This is the default build: no networking and no encryption (docs/OFFLINE.md).
# Sync, note sharing, encrypted notes, the AI plugin and remote content are
# CMake options that default to OFF and are not turned on here.
#
# Everything the build needs is in source=(), each at a pinned commit, so build() and check() need no network:
# CMake is told where each FetchContent dependency is (FETCHCONTENT_SOURCE_DIR_*) and not to download anything.
# yaml-cpp is the system package (it is in depends), so it is not fetched.
# The commits are the ones named in CMakeLists.txt and libs/ext/ink/core/CMakeLists.txt; change both together.

pkgbase=notolith
pkgname=('notolith' 'notolith-ink' 'notolith-hwfont' 'notolith-pdfview')
# The beta tag is "-beta.1" in CMake; pacman has no hyphen or tilde in a pkgver, and
# 0.1.0beta1 sorts before 0.1.0 under vercmp.
pkgver=0.1.0beta1
pkgrel=1
arch=('x86_64')
url='https://github.com/jernejmarcic/Notolith'
license=('GPL-3.0-or-later')
# abseil-cpp is the system Abseil that the ink core requires (docs/INK.md): without it the ink
# packages would silently not be built.
# poppler-qt6 is the PDF module's, not the application's: the executable links none of it.
makedepends=('cmake' 'ninja' 'git' 'gtest' 'abseil-cpp' 'poppler-qt6')
# The application first, then md4qt, MicroTeX, tinyxml2 and ink-stroke-modeler (their directories in src/ are the repository names).
source=('git+https://github.com/jernejmarcic/Notolith.git#tag=v0.1.0-beta.1'
        'git+https://invent.kde.org/libraries/md4qt.git#commit=e48716a41c1cf7f91b130fe3d3cc1c524e3b404a'
        'git+https://github.com/NanoMichael/MicroTeX.git#commit=0e3707f6dafebb121d98b53c64364d16fefe481d'
        'git+https://github.com/leethomason/tinyxml2.git#commit=321ea883b7190d4e85cae5512a12e5eaa8f8731f'
        'git+https://github.com/google/ink-stroke-modeler.git#commit=f2388813b0b25bc3e33d143d369a8367ab2e30c8')
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

# A distribution's makepkg.conf may target the build machine's own CPU
# (CachyOS ships -march=native, and target-cpu=native for Rust). Notolith takes
# none at all - it has to run on any x86-64 machine, see docs/PLATFORMS.md - so
# the package must not carry one either. Each function runs in its own shell,
# so build() and check() both call this.
_noNativeCPU() {
    CFLAGS=$(printf '%s' "$CFLAGS" | sed -E 's/-m(arch|tune)=[^ ]+//g')
    CXXFLAGS=$(printf '%s' "$CXXFLAGS" | sed -E 's/-m(arch|tune)=[^ ]+//g')
    RUSTFLAGS=$(printf '%s' "${RUSTFLAGS:-}" | sed -E 's/-C ?target-cpu=[^ ]+//g')
    export CFLAGS CXXFLAGS RUSTFLAGS
}

# FetchContent does not run a dependency's PATCH_COMMAND when it is given a source directory, so the two patches
# CMake would have applied (cmake/patch-md4qt.sh, cmake/patch-microtex.sh, each run in the dependency's own
# directory) are applied here.
prepare() {
    (cd "$srcdir/md4qt" && sh "$srcdir/Notolith/cmake/patch-md4qt.sh")
    (cd "$srcdir/MicroTeX" && sh "$srcdir/Notolith/cmake/patch-microtex.sh")
}

# The one configure step: build directory, then CMake options. CMake's libexec directory is /usr/libexec; Arch keeps
# it in /usr/lib (the plugin host goes to /usr/lib/notolith).
_configure() {
    local buildDir=$1
    shift
    cmake -S "$srcdir/Notolith" -B "$buildDir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBEXECDIR=lib \
        -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
        -DFETCHCONTENT_SOURCE_DIR_MD4QT="$srcdir/md4qt" \
        -DFETCHCONTENT_SOURCE_DIR_MICROTEX="$srcdir/MicroTeX" \
        -DFETCHCONTENT_SOURCE_DIR_TINYXML2="$srcdir/tinyxml2" \
        -DFETCHCONTENT_SOURCE_DIR_INK_STROKE_MODELER="$srcdir/ink-stroke-modeler" \
        "$@"
}

build() {
    _noNativeCPU
    _configure build -DBUILD_TESTING=OFF
    cmake --build build
}

# The packaged build has no tests (they are not installed and would only slow
# build() down), so this configures a second tree with them on.
check() {
    _noNativeCPU
    _configure build-test -DBUILD_TESTING=ON
    cmake --build build-test
    QT_QPA_PLATFORM=offscreen ctest --test-dir build-test --output-on-failure
}

package_notolith() {
    pkgdesc='A Markdown note app for developers'
    # What is built into the binary besides the application's own GPL: md4qt, MicroTeX and yaml-cpp (MIT), tinyxml2
    # (Zlib), Lucide icons (ISC) and MicroTeX's fonts (SIL OFL 1.1, the Knuth licence and the dsrom licence).
    # THIRD-PARTY.md has the texts.
    license=('GPL-3.0-or-later' 'MIT' 'Zlib' 'ISC' 'OFL-1.1' 'LicenseRef-Knuth' 'LicenseRef-dsrom')
    # The package was called noteappc before the app was named Notolith.
    conflicts=('noteappc')
    replaces=('noteappc')
    # bubblewrap is a hard dependency: without it code blocks, TeX and plugins
    # are refused (there is no unsandboxed fallback). util-linux is prlimit, the sandbox's task limit.
    depends=('qt6-base' 'qt6-svg' 'qt6-multimedia' 'yaml-cpp' 'hunspell'
             'syntax-highlighting' 'litehtml' 'libgit2' 'libarchive' 'zeromq' 'libseccomp'
             'bubblewrap' 'util-linux')
    optdepends=('hunspell-en_gb: British English spelling'
                'hunspell-en_us: American English spelling')
    # cmake --install also puts LICENSE and THIRD-PARTY.md in usr/share/licenses/notolith, and the plugin host
    # in usr/lib/notolith.
    DESTDIR="$pkgdir" cmake --install build
    # The modules belong to their own packages; the base application never links them.
    # (usr/lib is what CMake's GNUInstallDirs gives on Arch with prefix /usr; the packages below name it the same way.)
    rm -r "$pkgdir/usr/lib/notolith/modules"
}

package_notolith-ink() {
    pkgdesc='Notolith handwritten notes: the ink core library and the .ink module'
    # ink-stroke-modeler (Apache-2.0) is linked into the core library.
    license=('GPL-3.0-or-later' 'Apache-2.0')
    # Versioned: a module only loads in the build that made it (the ABI tag), so pacman must not mix versions.
    depends=("notolith=$pkgver-$pkgrel" 'abseil-cpp')
    # One install unit: later markup and recognition hooks go into this module.
    install -Dm755 -t "$pkgdir/usr/lib/notolith/modules" \
        build/modules/libnotolith-inkcore.so build/modules/notolith-ink.so
    # The Apache-2.0 text of ink-stroke-modeler is in THIRD-PARTY.md.
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$srcdir/Notolith/LICENSE" "$srcdir/Notolith/THIRD-PARTY.md"
}

package_notolith-hwfont() {
    pkgdesc='Notolith glyph studio: capture your handwriting letter by letter'
    # No manifest "dependencies" key: pacman enforces this one.
    depends=("notolith-ink=$pkgver-$pkgrel")
    install -Dm755 -t "$pkgdir/usr/lib/notolith/modules" build/modules/notolith-hwfont.so
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$srcdir/Notolith/LICENSE" "$srcdir/Notolith/THIRD-PARTY.md"
}

package_notolith-pdfview() {
    pkgdesc='Notolith PDF viewer and annotation, and PDF embeds in notes'
    # poppler-qt6 is GPL; keeping it out of the base package keeps it out of every start that meets no PDF.
    # Both libraries install side by side: the module finds libnotolith-pdfpage.so through $ORIGIN, the
    # application finds the same file by directory (libs/render/PdfPage.cpp).
    depends=("notolith=$pkgver-$pkgrel" 'poppler-qt6')
    install -Dm755 -t "$pkgdir/usr/lib/notolith/modules" \
        build/modules/libnotolith-pdfpage.so build/modules/notolith-pdfview.so
    install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" "$srcdir/Notolith/LICENSE" "$srcdir/Notolith/THIRD-PARTY.md"
}
